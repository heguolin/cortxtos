{
  "name": "cortxtos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CortxtOS · 自托管个人 AI 工作台（知识库问答主轴 + 每日简报副轴）",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "cortxt": "bin/cortxt.mjs"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node bin/cortxt.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@hono/node-server": "^1.14.4",
    "@mozilla/readability": "^0.6.0",
    "@node-rs/argon2": "^2.2.1",
    "@node-rs/jieba": "^2.0.3",
    "better-sqlite3": "^12.2.0",
    "dompurify": "^3.4.15",
    "hono": "^4.9.7",
    "jsdom": "^30.1.0",
    "marked": "^18.0.13",
    "sqlite-vec": "^0.1.6",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.5.2",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^3.2.4",
    "vue": "^3.5.19",
    "vue-tsc": "^3.1.0"
  }
}
